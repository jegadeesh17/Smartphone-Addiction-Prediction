# Network host address for the FastAPI backend (e.g., 127.0.0.1 or 0.0.0.0)
APP_HOST=

# Network port for the FastAPI/Uvicorn server (default 8000)
APP_PORT=

# Debug mode flag for verbose ASGI logging (True or False)
APP_DEBUG=

# Path to the serialized LightGBM Fold 1 machine learning model file
MODEL_PATH=

# Path to the pre-computed population priors JSON data file
PRIORS_PATH=

# Path to the pre-aggregated population cohort summary distributions JSON file
COHORT_CACHE_PATH=

# When set to True, activates the calibrated heuristic mock inference engine
USE_MOCK_MODEL=

# Allowed CORS origins for browser client communication (comma-separated or JSON list)
CORS_ORIGINS=

